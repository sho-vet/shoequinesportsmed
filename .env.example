# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local — they are already in .gitignore.

# --- Supabase (Settings > API in your Supabase project) ---
# Safe to expose to the browser (protected by Row Level Security, see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used only in API routes / server actions, never shipped to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.shoequinesportsmedicine.com

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Spam protection (optional, recommended for production) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Payment links per country (set these to your real provider checkout/payment links) ---
NEXT_PUBLIC_PAYMENT_LINK_CO=
NEXT_PUBLIC_PAYMENT_LINK_EC=
NEXT_PUBLIC_PAYMENT_LINK_PE=
NEXT_PUBLIC_PAYMENT_LINK_US=
